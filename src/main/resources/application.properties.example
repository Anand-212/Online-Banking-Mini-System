# Database Connection Settings (Oracle XE)
db.driver=oracle.jdbc.driver.OracleDriver
db.url=jdbc:oracle:thin:@localhost:1521:xe
db.username=system
db.password=your_oracle_password_here

# Connection Pool Settings
db.pool.initialSize=5
db.pool.maxSize=20

# Session Configuration
session.timeout.minutes=30

# Application Metadata
app.name=EasyBank
app.version=1.0.0
app.support.email=support@easybank.com
app.support.phone=+91-1800-555-EASY

# Security Settings
security.mpin.maxAttempts=3
security.mpin.lockoutMinutes=15
